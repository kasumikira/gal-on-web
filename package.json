{
  "name": "gal-on-web",
  "private": true,
  "type": "module",
  "imports": {
    "#krkr/*": "./web/engine-js/common/*.js"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm dev:go\" \"pnpm dev:vite\"",
    "dev:go": "go run ./cmd/galweb -engine krkr-js",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "build:js": "vite build",
    "engine:inventory": "node tools/engine-inventory.mjs",
    "build:vm": "node native/kirikiri/build.mjs"
  },
  "dependencies": {
    "chardet": "2.1.0",
    "fft.js": "4.0.4",
    "gl-matrix": "3.4.4",
    "libarchive.js": "2.0.2",
    "lru-cache": "11.5.3",
    "mediabunny": "1.61.3",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@rollup/plugin-babel": "^7.1.0",
    "concurrently": "9.2.1",
    "vite": "7.1.9"
  }
}
