{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "wasm-release",
      "displayName": "Kirikiri WASM Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../out/kirikiri",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../out/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    }
  ],
  "buildPresets": [
    { "name": "wasm-release", "configurePreset": "wasm-release", "targets": ["tjs-runtime"] }
  ]
}
